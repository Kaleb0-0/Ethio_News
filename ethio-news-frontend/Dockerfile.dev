# Development Dockerfile for Frontend
# Keeps Node.js for hot reload
FROM node:22-alpine

WORKDIR /app

# Install build dependencies needed for native modules
RUN apk add --no-cache python3 make g++

COPY package*.json ./

# Fresh npm install with proper build tools
RUN npm ci --prefer-offline

COPY . .

EXPOSE 5173

# Run Vite in host mode to support hot reload
CMD ["npm", "run", "dev", "--", "--host"]
